[Unit]
Description=Jarvis SOCKS-туннель на VPS point (Edge TTS, YouTube — с asus напрямую не открываются)
After=network-online.target

[Service]
Type=simple
# Ключ asus на point ограничен в authorized_keys: только проброс портов, без шелла.
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:1080 \
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
    root@2.26.88.227
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
