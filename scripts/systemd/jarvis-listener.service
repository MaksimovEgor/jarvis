[Unit]
Description=Jarvis listener (wake word → запись команды → core)
After=jarvis-core.service
Wants=jarvis-core.service

[Service]
Type=simple
WorkingDirectory=%h/jarvis
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/jarvis/.venv/bin/python -m app.listener
# arecord может отвалиться (гарнитуру выдернули и т.п.) — просто поднимаемся заново
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
