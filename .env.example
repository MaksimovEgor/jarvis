# hermes — основной профиль Hermes Agent (ключ = API_SERVER_KEY из ~/.hermes/.env),
# builtin — свой агентный цикл через LLM_* ниже.
AGENT_BACKEND=hermes
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# С NVIDIA (GTX 1050, 2 ГБ): medium/int8 на GPU, ~1,6 с на фразу. Без драйвера — small/cpu.
STT_MODEL_SIZE=medium
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru

# vosk — нейроголос локально на asus (модель ~900 МБ в data/models/vosk-tts,
# качать через прокси: напрямую alphacephei.com отдаёт ~1 КБ/с);
# edge — Microsoft через туннель (нестабилен); при сбое — Piper.
TTS_ENGINE=vosk
VOSK_TTS_SPEAKER=3
EDGE_TTS_VOICE=ru-RU-DmitryNeural
EDGE_TTS_PROXY=socks5://127.0.0.1:1080
TTS_VOICE_PATH=data/models/piper/ru_RU-dmitri-medium.onnx

SEARXNG_URL=http://127.0.0.1:8080
MUSIC_LIBRARY_DIR=data/music
# Лайки (навсегда) + кэш (LRU) вместе — не больше этого, МБ.
MUSIC_STORAGE_MAX_MB=10240
# Профиль Hermes «dj» (scripts/hermes-dj/setup.sh впишет ключ сам).
DJ_HERMES_URL=http://127.0.0.1:8643
DJ_HERMES_API_KEY=
MPV_SOCKET=/tmp/jarvis-mpv.sock
# Через туннель: напрямую YouTube с asus не открывается.
YOUTUBE_PROXY=socks5://127.0.0.1:1080
MUSIC_VOLUME=60

# Вход в веб снаружи: bcrypt-хэш пароля (пусто — без входа, для разработки)
WEB_AUTH_USER=egor
WEB_AUTH_HASH=
